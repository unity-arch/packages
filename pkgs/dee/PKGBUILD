# Maintainer: Charlie <dev.charlie@akao.au>

pkgname=dee
_ver=1.2.7
_snap=17.10.20170616
_deb=8build1
pkgver=${_ver}.${_snap}
pkgrel=1
pkgdesc='model to synchronize multiple instances over dbus, used by the unity dash'
arch=('x86_64')
url='https://launchpad.net/dee'
license=('LGPL-3.0-only')
depends=('glib2' 'icu' 'python-gobject')
makedepends=('gobject-introspection' 'vala' 'gnome-common' 'gtk-doc' 'python' 'dbus-glib')
source=("${pkgname}_${_ver}+${_snap}.orig.tar.gz::https://launchpad.net/ubuntu/+archive/primary/+files/${pkgname}_${_ver}+${_snap}.orig.tar.gz"
        "https://launchpad.net/ubuntu/+archive/primary/+files/${pkgname}_${_ver}+${_snap}-${_deb}.debian.tar.xz")
sha256sums=('e63f979a7a5012a7786786f8081a9279256ab28ece6e557c6ce5bf87535ae899'
            'c13e2c0c3f98843011097d8e1afcb493dd41a923913a748c81c4995e19472fb0')
noextract=("${pkgname}_${_ver}+${_snap}.orig.tar.gz")

prepare() {
  mkdir -p "${pkgname}"
  tar xzf "${pkgname}_${_ver}+${_snap}.orig.tar.gz" -C "${pkgname}"
  cd "${pkgname}"
  # ubuntu carries the fixes for current vala, icu and gcc, take them as is
  local p
  for p in $(grep -v '^#' ../debian/patches/series); do
    patch -Np1 -i "../debian/patches/${p}"
  done
  NOCONFIGURE=1 ./autogen.sh
}

build() {
  cd "${pkgname}"
  PYTHON=/usr/bin/python ./configure --prefix=/usr --disable-static --disable-tests --disable-gtk-doc
  make
}

package() {
  cd "${pkgname}"
  make DESTDIR="${pkgdir}" install
  make -C bindings/python DESTDIR="${pkgdir}" install
}
