# Maintainer: Charlie <dev.charlie@akao.au>

pkgname=indicator-application
_ver=12.10.1
_snap=19.04.20190308.1
_deb=0ubuntu6
pkgver=${_ver}.${_snap}
pkgrel=1
pkgdesc='indicator hosting application status icons exported over the appindicator protocol'
arch=('x86_64')
url='https://launchpad.net/indicator-application'
license=('GPL-3.0-only')
depends=('gtk3' 'glib2' 'libindicator-gtk3' 'libappindicator' 'libdbusmenu-gtk3'
         'libdbusmenu-glib' 'json-glib' 'dbus-glib')
# dbus-binding-tool comes from dbus-glib, it generates the notification watcher stubs
makedepends=('glib2-devel' 'gnome-common' 'intltool' 'libtool')
# ubuntu archive tarballs, they come off a cdn where git.launchpad.net doesn't
source=("https://launchpad.net/ubuntu/+archive/primary/+sourcefiles/${pkgname}/${_ver}+${_snap}-${_deb}/${pkgname}_${_ver}+${_snap}.orig.tar.gz"
        "https://launchpad.net/ubuntu/+archive/primary/+sourcefiles/${pkgname}/${_ver}+${_snap}-${_deb}/${pkgname}_${_ver}+${_snap}-${_deb}.diff.gz")
sha256sums=('f701326a6cfb6fd963d398b649353d68acdffad9f8cdcdca7a8b8cb0a60d6da2'
            '99ec51f8010167f298120e9dab0267f9084c59c51dfa82616864fdbf72270efd')
# the orig tarball has no top level directory
noextract=("${pkgname}_${_ver}+${_snap}.orig.tar.gz")

prepare() {
  mkdir -p "${pkgname}"
  tar xzf "${pkgname}_${_ver}+${_snap}.orig.tar.gz" -C "${pkgname}"
  cd "${pkgname}"
  # source format 1.0, the whole debian delta is the one diff
  patch -Np1 -i "${srcdir}/${pkgname}_${_ver}+${_snap}-${_deb}.diff"
  # no quilt series in this tree, apply one if a later snapshot grows it
  if [[ -s debian/patches/series ]]; then
    local p
    while read -r p; do
      [[ -z ${p} || ${p} == \#* ]] && continue
      patch -Np1 -i "debian/patches/${p}"
    done < debian/patches/series
  fi
  NOCONFIGURE=1 ./autogen.sh
}

build() {
  cd "${pkgname}"
  # dbus-glib and the gtk status icon calls this wraps are deprecated top to bottom
  CFLAGS+=' -Wno-error=deprecated-declarations'
  # libexecdir so pkglibexecdir is /usr/lib/indicator-application, data/Makefile.am seds
  # that same value into the systemd unit and the autostart desktop file
  ./configure \
    --prefix=/usr \
    --sysconfdir=/etc \
    --localstatedir=/var \
    --libexecdir=/usr/lib \
    --disable-static
  make
}

package() {
  cd "${pkgname}"
  make DESTDIR="${pkgdir}" install
  # upstart is gone on arch, the systemd user unit is what unity-panel-service wants,
  # and the second copy of the desktop file under pkgdatadir is an upstart xdg override
  rm -rf "${pkgdir}/usr/share/upstart" \
    "${pkgdir}/usr/share/${pkgname}/upstart"
}
