# Maintainer: Charlie <dev.charlie@akao.au>

pkgname=libindicator-gtk3
_name=libindicator
_ver=16.10.0
_snap=18.04.20180321.1
pkgver=${_ver}.${_snap}
pkgrel=1
pkgdesc='shared library for the ubuntu indicators, gtk3 flavour'
arch=('x86_64')
url='https://launchpad.net/libindicator'
license=('GPL-3.0-only')
depends=('gtk3' 'ido')
makedepends=('gnome-common' 'intltool' 'gtk-doc')
provides=('libindicator3' 'indicator-common')
source=("${_name}_${_ver}+${_snap}.orig.tar.gz::https://launchpad.net/ubuntu/+archive/primary/+files/${_name}_${_ver}+${_snap}.orig.tar.gz"
        'libindicator-ido-menu-items.patch')
sha256sums=('0029ac3aa8d5a339de252f66209b40c12e5bfa9072221b9b32d07844273f62fd'
            '2159393f813da09e7e91e9e7e5f29964fdf10b2d10721326b41c15dde5785c4d')
noextract=("${_name}_${_ver}+${_snap}.orig.tar.gz")

prepare() {
  mkdir -p "${_name}"
  tar xzf "${_name}_${_ver}+${_snap}.orig.tar.gz" -C "${_name}"
  cd "${_name}"
  patch -p1 -i "${srcdir}/libindicator-ido-menu-items.patch"
  NOCONFIGURE=1 ./autogen.sh
}

build() {
  cd "${_name}"
  # Makefile.am hardcodes -Werror and glib's deprecated macros are pragma warnings
  # with no option to switch off, so drop the deprecation pragmas instead
  ./configure --prefix=/usr --disable-static --with-gtk=3 --disable-tests \
    CFLAGS="${CFLAGS} -DGLIB_DISABLE_DEPRECATION_WARNINGS"
  make
}

package() {
  cd "${_name}"
  make DESTDIR="${pkgdir}" install
  rm -f "${pkgdir}"/usr/lib/libdummy-indicator*
}
