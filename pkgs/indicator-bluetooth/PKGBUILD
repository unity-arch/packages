# Maintainer: Charlie <dev.charlie@akao.au>

pkgname=indicator-bluetooth
_ver=0.0.6
_snap=17.10.20170605
_deb=0ubuntu7
pkgver=${_ver}.${_snap}
pkgrel=1
pkgdesc='indicator for bluetooth power and device controls'
arch=('x86_64')
url='https://launchpad.net/indicator-bluetooth'
license=('GPL-3.0-only')
# bluez is talked to over dbus at runtime, killswitch.vala pokes /dev/rfkill directly
depends=('glib2' 'bluez')
optdepends=('gnome-bluetooth: send files and the device setup panel'
            'unity-control-center: bluetooth settings panel from the menu')
makedepends=('glib2-devel' 'gnome-common' 'intltool' 'vala')
# ubuntu archive tarballs, they come off a cdn where git.launchpad.net doesn't
source=("https://launchpad.net/ubuntu/+archive/primary/+sourcefiles/${pkgname}/${_ver}+${_snap}-${_deb}/${pkgname}_${_ver}+${_snap}.orig.tar.gz"
        "https://launchpad.net/ubuntu/+archive/primary/+sourcefiles/${pkgname}/${_ver}+${_snap}-${_deb}/${pkgname}_${_ver}+${_snap}-${_deb}.diff.gz")
sha256sums=('d67cf0687526c9e9e70c451242fd6f3db0588ce052d2ef498680fcea0083e846'
            '910401cefe815963148b4fde94d12fd33f405c9a69e6e1816738b7ca6474012f')
# the orig tarball has no top level directory
noextract=("${pkgname}_${_ver}+${_snap}.orig.tar.gz")

prepare() {
  mkdir -p "${pkgname}"
  tar xzf "${pkgname}_${_ver}+${_snap}.orig.tar.gz" -C "${pkgname}"
  cd "${pkgname}"
  # source format 1.0, the whole debian delta is the one diff
  patch -Np1 -i "${srcdir}/${pkgname}_${_ver}+${_snap}-${_deb}.diff"
  # no quilt series in this tree, apply one if a later snapshot grows it
  if [[ -s debian/patches/series ]]; then
    local p
    while read -r p; do
      [[ -z ${p} || ${p} == \#* ]] && continue
      patch -Np1 -i "debian/patches/${p}"
    done < debian/patches/series
  fi
  NOCONFIGURE=1 ./autogen.sh
}

build() {
  cd "${pkgname}"
  # libexecdir so pkglibexecdir is /usr/lib/indicator-bluetooth, data/Makefile.am seds
  # that same value into the systemd unit
  ./configure \
    --prefix=/usr \
    --sysconfdir=/etc \
    --localstatedir=/var \
    --libexecdir=/usr/lib \
    --disable-static
  make
}

package() {
  cd "${pkgname}"
  make DESTDIR="${pkgdir}" install
  # upstart is gone on arch, the systemd user unit is what unity-panel-service wants
  rm -rf "${pkgdir}/usr/share/upstart"
}
