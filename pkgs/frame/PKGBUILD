# Maintainer: Charlie <dev.charlie@akao.au>

pkgname=frame
pkgver=2.5.0
pkgrel=1
pkgdesc='touch frame library, buildup and sync of simultaneous touches'
arch=('x86_64')
url='https://launchpad.net/frame'
license=('GPL-3.0-or-later')
depends=('libxi' 'gcc-libs')
makedepends=('xorg-server-devel' 'asciidoc')
source=("https://deb.debian.org/debian/pool/main/f/frame/frame_${pkgver}.orig.tar.xz")
sha256sums=('bc2a20cd3ac1e61fe0461bd3ee8cb250dbcc1fa511fad0686d267744e9c78f3a')

build() {
  cd "${pkgname}-${pkgver}"
  ./configure --prefix=/usr --disable-static
  make
}

package() {
  cd "${pkgname}-${pkgver}"
  make DESTDIR="${pkgdir}" install
}
