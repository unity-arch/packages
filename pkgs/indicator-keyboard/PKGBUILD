# Maintainer: Charlie <dev.charlie@akao.au>

pkgname=indicator-keyboard
_ver=0.0.0
_snap=19.10.20240924
_commit=dc3fd5db0771f5c9bf96478299e6c89b0987f234
pkgver=${_ver}.${_snap}
pkgrel=1
pkgdesc='indicator showing the current keyboard layout and input source'
arch=('x86_64')
url='https://code.launchpad.net/indicator-keyboard'
license=('LGPL-3.0-only')
depends=('glib2' 'gtk3' 'libgee' 'gnome-desktop' 'libgnomekbd' 'libxklavier' 'ibus'
         'accountsservice' 'lightdm' 'libindicator-gtk3' 'pango' 'libx11')
makedepends=('glib2-devel' 'git' 'intltool' 'vala' 'libtool' 'gobject-introspection')
source=("git+https://git.launchpad.net/ubuntu/+source/${pkgname}#commit=${_commit}"
        'drop-fcitx.patch'
        'drop-accountsservice-input-sources.patch')
sha256sums=('SKIP'
            'b3fc9784fd3db2bf2ea97014fa4f689658f7bc8695efd2a4106b49a13e38d9f3'
            '8b0ab016ea29ad43fdada3ecb70e484ab1a0b8463bcb7a3323358f193acc956d')

prepare() {
  cd "${pkgname}"
  # no quilt series in this snapshot, apply one if a later import grows it
  if [[ -s debian/patches/series ]]; then
    local p
    while read -r p; do
      [[ -z ${p} || ${p} == \#* ]] && continue
      patch -Np1 -i "debian/patches/${p}"
    done < debian/patches/series
  fi
  patch -Np1 -i "${srcdir}/drop-fcitx.patch"
  patch -Np1 -i "${srcdir}/drop-accountsservice-input-sources.patch"
  NOCONFIGURE=1 ./autogen.sh
}

build() {
  cd "${pkgname}"
  # libexecdir so the service lands at /usr/lib/indicator-keyboard, the systemd unit
  # and the upstart job both get pkglibexecdir substituted in from here
  ./configure \
    --prefix=/usr \
    --sysconfdir=/etc \
    --libexecdir=/usr/lib \
    --disable-static
  make
}

package() {
  cd "${pkgname}"
  make DESTDIR="${pkgdir}" install

  # upstart is gone, the systemd user unit is what unity-panel-service wants
  rm -rf "${pkgdir}/usr/share/upstart"
  # the autopilot suite installs itself into site-packages, autopilot is ubuntu only
  # and these are tests, not part of the indicator
  rm -rf "${pkgdir}/usr/lib/python"*
}
