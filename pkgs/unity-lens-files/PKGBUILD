# Maintainer: Charlie <dev.charlie@akao.au>

pkgname=unity-lens-files
_ver=7.1.0
_snap=17.10.20170605
_commit=7178acb0aff96dfad802d509749b3903d0954de8
pkgver=${_ver}.${_snap}
pkgrel=1
pkgdesc='files and folders scope for the unity dash'
arch=('x86_64')
url='https://gitlab.com/ubuntu-unity/unity/unity-lens-files'
license=('GPL-3.0-only')
# zeitgeist is the daemon too, the scope has nothing to show without it running
depends=('dee' 'glib2' 'libgee' 'libunity' 'zeitgeist')
makedepends=('glib2-devel' 'git' 'gnome-common' 'intltool' 'vala')
# the use-locate gsetting shells out to locate, absence just throws and the search
# falls back to zeitgeist results
optdepends=('plocate: filename search beyond the zeitgeist history')
source=("git+${url}.git#commit=${_commit}")
sha256sums=('SKIP')

prepare() {
  cd "${pkgname}"
  # no quilt series upstream right now, apply one if a later snapshot grows it
  if [[ -s debian/patches/series ]]; then
    local p
    while read -r p; do
      [[ -z ${p} || ${p} == \#* ]] && continue
      patch -Np1 -i "debian/patches/${p}"
    done < debian/patches/series
  fi
  NOCONFIGURE=1 ./autogen.sh
}

build() {
  cd "${pkgname}"
  # libexecdir is /usr/lib so pkglibexecdir lands in /usr/lib/unity-lens-files, the
  # dbus service file substitutes @pkglibexecdir@ so it follows along
  ./configure \
    --prefix=/usr \
    --sysconfdir=/etc \
    --localstatedir=/var \
    --libexecdir=/usr/lib \
    --disable-static
  make
}

package() {
  cd "${pkgname}"
  # configure hands po/Makefile a literal ${DATADIRNAME} that make never expands, so the
  # catalogs land in /usr/locale unless we feed it in here
  make DESTDIR="${pkgdir}" DATADIRNAME=share install
}
