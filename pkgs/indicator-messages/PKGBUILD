# Maintainer: Charlie <dev.charlie@akao.au>

pkgname=indicator-messages
_ver=13.10.1
_snap=18.10.20180918
_deb=0ubuntu8
pkgver=${_ver}.${_snap}
pkgrel=1
pkgdesc='indicator collecting messages that need a response, plus libmessaging-menu'
arch=('x86_64')
url='https://launchpad.net/indicator-messages'
license=('GPL-3.0-only')
depends=('glib2' 'accountsservice' 'libindicator-gtk3')
makedepends=('glib2-devel' 'gnome-common' 'intltool' 'vala' 'gobject-introspection')
provides=('libmessaging-menu' 'messaging-menu')
# ubuntu archive tarballs, they come off a cdn where git.launchpad.net doesn't
source=("https://launchpad.net/ubuntu/+archive/primary/+sourcefiles/${pkgname}/${_ver}+${_snap}-${_deb}/${pkgname}_${_ver}+${_snap}.orig.tar.gz"
        "https://launchpad.net/ubuntu/+archive/primary/+sourcefiles/${pkgname}/${_ver}+${_snap}-${_deb}/${pkgname}_${_ver}+${_snap}-${_deb}.diff.gz"
        'drop-dbustest-check.patch')
sha256sums=('d051dd845912e2f5d6be5bfcbd9ce2c53460f011707d29ab728bee5f15938ce7'
            '97abd1e4b454571f94cde931677c09f4209b50966289663ae9abc1471ea537c3'
            '372f55326c4180542a7401c284c83cf7254ce552a9a3fe5d05489ddebb3ab37e')
# the orig tarball has no top level directory
noextract=("${pkgname}_${_ver}+${_snap}.orig.tar.gz")

prepare() {
  mkdir -p "${pkgname}"
  tar xzf "${pkgname}_${_ver}+${_snap}.orig.tar.gz" -C "${pkgname}"
  cd "${pkgname}"
  # source format 1.0, the whole debian delta is the one diff
  patch -Np1 -i "${srcdir}/${pkgname}_${_ver}+${_snap}-${_deb}.diff"
  # no quilt series in this snapshot, apply one if a later import grows it
  if [[ -s debian/patches/series ]]; then
    local p
    while read -r p; do
      [[ -z ${p} || ${p} == \#* ]] && continue
      patch -Np1 -i "debian/patches/${p}"
    done < debian/patches/series
  fi
  patch -Np1 -i "${srcdir}/drop-dbustest-check.patch"
  NOCONFIGURE=1 ./autogen.sh
}

build() {
  cd "${pkgname}"
  # libexecdir=/usr/lib puts the service at /usr/lib/indicator-messages, both the
  # systemd unit and the autostart file get that path substituted in at build time
  # (debian's own path is /usr/lib/x86_64-linux-gnu/indicator-messages)
  # gtk-doc off, debian only builds it for a -doc binary package we don't ship
  ./configure \
    --prefix=/usr \
    --sysconfdir=/etc \
    --libexecdir=/usr/lib \
    --disable-static \
    --disable-tests \
    --enable-introspection \
    --enable-vala
  make
}

package() {
  cd "${pkgname}"
  make DESTDIR="${pkgdir}" install

  # upstart is gone, and the systemd user unit is what unity-panel-service wants
  rm -rf "${pkgdir}/usr/share/upstart"
  # the xdg autostart entry starts the same binary a second time under a session
  # that already has the user unit, so it's dropped rather than shipped alongside
  rm -rf "${pkgdir}/etc/xdg"
}
