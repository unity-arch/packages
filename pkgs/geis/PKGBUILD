# Maintainer: Charlie <dev.charlie@akao.au>

pkgname=geis
_ver=2.2.17
_snap=16.04.20160126
pkgver=${_ver}.${_snap}
pkgrel=1
pkgdesc='gesture engine interface and support library'
arch=('x86_64')
url='https://launchpad.net/geis'
license=('LGPL-3.0-only' 'GPL-3.0-only')
depends=('grail' 'frame' 'dbus' 'libxi' 'libxcb' 'python')
makedepends=('xorg-server-devel' 'libxslt' 'python-setuptools')
provides=('libgeis')
source=("https://launchpad.net/ubuntu/+archive/primary/+files/${pkgname}_${_ver}+${_snap}.orig.tar.gz")
sha256sums=('d88309cb4039e66c63ed95864b6cac8612c3b7138c26fab81440d694759c6df4')

prepare() {
  cd "${pkgname}-${_ver}+${_snap}"
  NO_CONFIGURE=1 ./autogen.sh
}

build() {
  cd "${pkgname}-${_ver}+${_snap}"
  ./configure --prefix=/usr --disable-static --disable-integration-tests
  make
}

package() {
  cd "${pkgname}-${_ver}+${_snap}"
  make DESTDIR="${pkgdir}" install
}
