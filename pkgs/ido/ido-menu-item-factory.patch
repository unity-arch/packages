+/* the factory interface used to live in ubuntu's patched gtk3, it lives here now */
+G_DEFINE_INTERFACE_WITH_CODE (IdoMenuItemFactory, ido_menu_item_factory, G_TYPE_OBJECT,
+  GIOExtensionPoint *ep = g_io_extension_point_register (IDO_MENU_ITEM_FACTORY_EXTENSION_POINT_NAME);
+  g_io_extension_point_set_required_type (ep, g_define_type_id);)
+
+static void
+ido_menu_item_factory_default_init (IdoMenuItemFactoryInterface *iface)
+{
+}
+
+GtkMenuItem *
+ido_menu_item_factory_create_menu_item (IdoMenuItemFactory *factory,
+                                        const gchar        *type,
+                                        GMenuItem          *menuitem,
+                                        GActionGroup       *actions)
+{
+  return IDO_MENU_ITEM_FACTORY_GET_IFACE (factory)->create_menu_item (factory, type, menuitem, actions);
+}
+
+#define IDO_TYPE_MENU_ITEM_FACTORY_IMPL (ido_menu_item_factory_impl_get_type ())
+
+typedef GObject      IdoMenuItemFactoryImpl;
+typedef GObjectClass IdoMenuItemFactoryImplClass;
+
+GType       ido_menu_item_factory_impl_get_type (void);
+static void ido_menu_item_factory_impl_interface_init (IdoMenuItemFactoryInterface *iface);
+
+G_DEFINE_TYPE_WITH_CODE (IdoMenuItemFactoryImpl, ido_menu_item_factory_impl, G_TYPE_OBJECT,
+  G_IMPLEMENT_INTERFACE (IDO_TYPE_MENU_ITEM_FACTORY, ido_menu_item_factory_impl_interface_init)
+  g_io_extension_point_implement (IDO_MENU_ITEM_FACTORY_EXTENSION_POINT_NAME,
                                   g_define_type_id, "ido", 0);)
 
+/**
+ * ido_menu_item_factory_get_all:
+ *
+ * Returns: (element-type GObject) (transfer none): a static list of all
+ * registered factories
+ */
+GList *
+ido_menu_item_factory_get_all (void)
+{
+  static GList *factories = NULL;
+
+  if (factories == NULL)
+    {
+      GIOExtensionPoint *ep;
+      GList *it;
+
+      /* ensuring the implementation registers the extension point as well */
+      g_type_ensure (IDO_TYPE_MENU_ITEM_FACTORY_IMPL);
+
+      ep = g_io_extension_point_lookup (IDO_MENU_ITEM_FACTORY_EXTENSION_POINT_NAME);
+      for (it = g_io_extension_point_get_extensions (ep); it != NULL; it = it->next)
+        {
+          GIOExtension *ext = it->data;
+          IdoMenuItemFactory *factory;
+
+          factory = g_object_new (g_io_extension_get_type (ext), NULL);
+          factories = g_list_prepend (factories, factory);
+        }
+      factories = g_list_reverse (factories);
+    }
+
+  return factories;
+}
