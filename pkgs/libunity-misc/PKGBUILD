# Maintainer: Charlie <dev.charlie@akao.au>

pkgname=libunity-misc
_ver=4.0.5
_snap=14.04.20140115
pkgver=${_ver}.${_snap}
pkgrel=1
pkgdesc='miscellaneous differently licensed bits for unity'
arch=('x86_64')
url='https://launchpad.net/libunity-misc'
license=('LGPL-3.0-only')
depends=('gtk3')
makedepends=('glib2-devel' 'gnome-common' 'gtk-doc')
source=("https://launchpad.net/ubuntu/+archive/primary/+files/${pkgname}_${_ver}+${_snap}.orig.tar.gz")
sha256sums=('197fd17077c3ceac219cbfbe3cfa511a17dd47a86c441c386c7bdec200d119b7')

prepare() {
  cd "${pkgname}-${_ver}+${_snap}"
  # 2014 code, the -Werror it ships doesn't survive current gtk headers
  sed -i 's/-Werror /-Wno-error /' configure.ac
  NOCONFIGURE=1 ./autogen.sh
}

build() {
  cd "${pkgname}-${_ver}+${_snap}"
  ./configure --prefix=/usr --disable-static --disable-gtk-doc
  make
}

package() {
  cd "${pkgname}-${_ver}+${_snap}"
  make DESTDIR="${pkgdir}" install
}
