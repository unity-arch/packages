# Maintainer: Charlie <dev.charlie@akao.au>

pkgname=unity-settings-daemon
_ver=15.04.1
_snap=21.10.20220802
_commit=216f0547836a918dd6b40f18c295f9df3445858d
pkgver=${_ver}.${_snap}
pkgrel=1
pkgdesc='daemon handling the unity session settings'
arch=('x86_64')
url='https://gitlab.com/ubuntu-unity/unity/unity-settings-daemon'
license=('GPL-2.0-or-later' 'LGPL-2.1-or-later')
depends=('accountsservice' 'alsa-lib' 'colord' 'dbus-glib' 'fontconfig' 'gnome-desktop'
         'gsettings-desktop-schemas' 'gsettings-ubuntu-schemas' 'gtk3' 'hicolor-icon-theme'
         'ibus' 'lcms2' 'libcanberra' 'libgnomekbd' 'libgudev' 'libnm' 'libnotify' 'librsvg'
         'libpulse' 'libwacom' 'libxfixes' 'libxi' 'libxkbfile' 'libxklavier' 'libxrandr'
         'libxt' 'libxtst' 'polkit' 'upower' 'xkeyboard-config')
# xf86-input-wacom is only here for xorg-wacom.pc, the wacom plugin needs it at configure time
makedepends=('git' 'gnome-common' 'intltool' 'libxslt' 'docbook-xsl' 'mesa' 'xf86-input-wacom')
provides=('libunity-settings-daemon')
source=("git+${url}.git#commit=${_commit}"
        'drop-accountsservice-input-sources.patch')
sha256sums=('SKIP'
            '4ee3d079a6451c40b71d5361a2f5226c36b1de2f285997a327b3a87257021508')

prepare() {
  cd "${pkgname}"
  # upstream carries no quilt series right now, apply one if a later snapshot adds it
  if [[ -s debian/patches/series ]]; then
    local p
    while read -r p; do
      [[ -z ${p} || ${p} == \#* ]] && continue
      patch -Np1 -i "debian/patches/${p}"
    done < debian/patches/series
  fi
  patch -Np1 -i "${srcdir}/drop-accountsservice-input-sources.patch"
  NOCONFIGURE=1 ./autogen.sh
}

build() {
  cd "${pkgname}"
  # no --enable-systemd here, configure.ac has no such option (debian/rules doesn't pass it either)
  # fcitx off because the code only knows the fcitx4 pkg-config names and fcitx4 is gone
  # smartcard stays off, configure errors out on --enable-smartcard-support anyway
  ./configure \
    --prefix=/usr \
    --sysconfdir=/etc \
    --localstatedir=/var \
    --libexecdir=/usr/lib/unity-settings-daemon \
    --disable-static \
    --disable-more-warnings \
    --disable-fcitx \
    --enable-ibus \
    --enable-network-manager \
    --enable-rfkill \
    --disable-packagekit
  make
}

package() {
  cd "${pkgname}"
  make DESTDIR="${pkgdir}" install

  install -dm755 "${pkgdir}/usr/bin"
  ln -s /usr/lib/unity-settings-daemon/unity-settings-daemon \
    "${pkgdir}/usr/bin/unity-settings-daemon"

  # the unit only exists in debian/, no session.target.wants symlink for it here
  # (unity-session pulls it in itself), and upstart and apport stay dropped
  install -Dm644 debian/user/unity-settings-daemon.service \
    "${pkgdir}/usr/lib/systemd/user/unity-settings-daemon.service"
}
