# Maintainer: Charlie <dev.charlie@akao.au>

pkgname=unity-gtk-module
_ver=0.0.0
_snap=18.04.20171202
_deb=0ubuntu7
pkgver=${_ver}.${_snap}
pkgrel=1
pkgdesc='gtk module exporting application menus over dbusmenu for the unity panel'
arch=('x86_64')
url='https://launchpad.net/unity-gtk-module'
license=('LGPL-3.0-only')
depends=('glib2' 'gtk3' 'gtk2' 'libx11' 'glibc')
makedepends=('glib2-devel' 'gnome-common' 'gtk-doc' 'python')
# ubuntu archive tarballs, 1.0 format so the debian bits arrive as a diff
source=("https://launchpad.net/ubuntu/+archive/primary/+sourcefiles/${pkgname}/${_ver}+${_snap}-${_deb}/${pkgname}_${_ver}+${_snap}.orig.tar.gz"
        "https://launchpad.net/ubuntu/+archive/primary/+sourcefiles/${pkgname}/${_ver}+${_snap}-${_deb}/${pkgname}_${_ver}+${_snap}-${_deb}.diff.gz"
        'unity-gtk-module.sh')
sha256sums=('5a78ae6b021aaf35f573a56c7803773b0accdf34112ebfebd00651be87c0e28e'
            '94d7c67c30ac52e38c7b7c43c9e9bcbc48e20c1183d97cbc15748f47294a021a'
            '2b95dc99bed178eeeb5f0bc37bd3ba4e13d5faaa0f599b97679790b6de18527d')
# the orig tarball has no top level directory
noextract=("${pkgname}_${_ver}+${_snap}.orig.tar.gz")

prepare() {
  mkdir -p "${pkgname}"
  tar xzf "${pkgname}_${_ver}+${_snap}.orig.tar.gz" -C "${pkgname}"
  cd "${pkgname}"
  zcat "${srcdir}/${pkgname}_${_ver}+${_snap}-${_deb}.diff.gz" | patch -Np1
  # no quilt series in this snapshot, keep the loop so a later one gets picked up
  if [[ -s debian/patches/series ]]; then
    local p
    while read -r p; do
      [[ -z ${p} || ${p} == \#* ]] && continue
      patch -Np1 -i "debian/patches/${p}"
    done < debian/patches/series
  fi
  NOCONFIGURE=1 ./autogen.sh
}

build() {
  cd "${pkgname}"
  # the tree assigns GdkPixbuf and GDBusMenuModel straight into GIcon and
  # GMenuModel variables, safe gobject upcasts that gcc 16 now rejects outright
  CFLAGS+=' -Wno-error=incompatible-pointer-types'

  # one configure per toolkit like debian/rules does, --with-gtk picks which
  # parser and which gtk-N.0/modules dir the .so lands in
  local v
  for v in 2 3; do
    mkdir -p "build/gtk${v}"
    pushd "build/gtk${v}" >/dev/null
    ../../configure \
      --prefix=/usr \
      --sysconfdir=/etc \
      --localstatedir=/var \
      --disable-static \
      --disable-gtk-doc \
      --with-gtk=${v}
    make
    popd >/dev/null
  done
}

package() {
  cd "${pkgname}"
  # gtk2 first then gtk3, the shared headers and data land twice and the last
  # one wins, that's the order debian installs in too
  make -C build/gtk2 DESTDIR="${pkgdir}" install
  make -C build/gtk3 DESTDIR="${pkgdir}" install

  # upstart is dead and the autopilot helper wants python3-autopilot which isn't packaged
  rm -rf "${pkgdir}/usr/share/upstart" "${pkgdir}/usr/lib/python"*

  # debian carries this symlink in unity-gtk-module-common.links, the unit's own
  # [Install] section only takes effect on an explicit systemctl enable
  install -dm755 "${pkgdir}/usr/lib/systemd/user/unity-session.target.wants"
  ln -s ../unity-gtk-module.service \
    "${pkgdir}/usr/lib/systemd/user/unity-session.target.wants/unity-gtk-module.service"

  # the unit only reaches dbus activated and systemd started apps, so mirror it in
  # profile.d for anything launched from a shell, the way debian's old
  # /etc/X11/Xsession.d/80unity-gtk-module used to. environment.d is the wrong
  # home for it, those files are unconditional and would load the module under
  # every desktop the user logs into, not just unity
  install -Dm644 "${srcdir}/unity-gtk-module.sh" \
    "${pkgdir}/etc/profile.d/unity-gtk-module.sh"
}
