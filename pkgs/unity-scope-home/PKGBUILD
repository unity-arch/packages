# Maintainer: Charlie <dev.charlie@akao.au>

pkgname=unity-scope-home
_ver=6.8.2
_snap=19.04.20190412
_commit=ebf80fee24f1d20756fc14223cfccd7bff0c4857
pkgver=${_ver}.${_snap}
pkgrel=1
pkgdesc='home scope aggregating the master scopes for the unity dash'
arch=('x86_64')
url='https://gitlab.com/ubuntu-unity/unity/unity-scope-home'
license=('GPL-3.0-only')
depends=('dee' 'glib2' 'json-glib' 'libgee' 'libunity')
# util-linux-libs is only for uuid.pc, configure asks for it even though the smart
# scopes patch takes away the only caller so nothing links against libuuid
makedepends=('glib2-devel' 'git' 'gnome-common' 'intltool' 'util-linux-libs' 'vala')
# the master scope definitions used to be split out as unity-scopes-master-default,
# no point in a second package here since nothing else provides them
provides=('unity-scopes-master-default' 'unity-scopes-master')
source=("git+${url}.git#commit=${_commit}")
sha256sums=('SKIP')

prepare() {
  cd "${pkgname}"
  local p
  while read -r p; do
    [[ -z ${p} || ${p} == \#* ]] && continue
    patch -Np1 -i "debian/patches/${p}"
  done < debian/patches/series
  NOCONFIGURE=1 ./autogen.sh
}

build() {
  cd "${pkgname}"
  # libexecdir is /usr/lib so pkglibexecdir lands in /usr/lib/unity-scope-home, the
  # dbus service file substitutes @pkglibexecdir@ so it follows along
  ./configure \
    --prefix=/usr \
    --sysconfdir=/etc \
    --localstatedir=/var \
    --libexecdir=/usr/lib \
    --disable-static
  make
}

package() {
  cd "${pkgname}"
  make DESTDIR="${pkgdir}" install
}
