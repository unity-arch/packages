# Maintainer: Charlie <dev.charlie@akao.au>

pkgname=libunity
_ver=7.1.4
_snap=19.04.20190319
_deb=8
pkgver=${_ver}.${_snap}
pkgrel=1
pkgdesc='library for integrating with the unity shell, scopes and launcher api'
arch=('x86_64')
url='https://launchpad.net/libunity'
license=('LGPL-3.0-only')
depends=('dee' 'gtk3' 'libdbusmenu-glib' 'python-gobject')
makedepends=('gobject-introspection' 'vala' 'gnome-common' 'intltool')
source=("${pkgname}_${_ver}+${_snap}.orig.tar.gz::https://launchpad.net/ubuntu/+archive/primary/+files/${pkgname}_${_ver}+${_snap}.orig.tar.gz"
        "https://launchpad.net/ubuntu/+archive/primary/+files/${pkgname}_${_ver}+${_snap}-${_deb}.debian.tar.xz")
sha256sums=('56ecb380d74bf74caba193d9e8ad6b0c85ccf9eeb461bc9731c2b8636e1f1492'
            '693791d3e7339b16c014386023ff631e48a237d8ce58ac60083eab23475d6ad6')
noextract=("${pkgname}_${_ver}+${_snap}.orig.tar.gz")

prepare() {
  mkdir -p "${pkgname}"
  tar xzf "${pkgname}_${_ver}+${_snap}.orig.tar.gz" -C "${pkgname}"
  cd "${pkgname}"
  local p
  for p in $(grep -v '^#' ../debian/patches/series); do
    patch -Np1 -i "../debian/patches/${p}"
  done
  NOCONFIGURE=1 ./autogen.sh
}

build() {
  cd "${pkgname}"
  PYTHON=/usr/bin/python ./configure --prefix=/usr --disable-static
  make
}

package() {
  cd "${pkgname}"
  make DESTDIR="${pkgdir}" install
  make -C bindings/python DESTDIR="${pkgdir}" install
}
