# Maintainer: Charlie <dev.charlie@akao.au>

pkgname=nux
_ver=4.0.8
_snap=18.10.20180623
pkgver=${_ver}.${_snap}
pkgrel=2
pkgdesc='opengl toolkit unity is built on, widgets and a graphics abstraction layer'
arch=('x86_64')
url='https://gitlab.com/ubuntu-unity/unity/nux'
license=('LGPL-2.1-only' 'LGPL-3.0-only')
depends=('glib2' 'libsigc++' 'gdk-pixbuf2' 'cairo' 'pango' 'libpng' 'pcre2' 'icu'
         'ibus' 'geis' 'glewmx' 'glu' 'libglvnd' 'pciutils' 'libx11' 'libxext'
         'libxxf86vm' 'libxinerama' 'libxcomposite' 'libxdamage' 'gcc-libs')
makedepends=('git' 'gnome-common')
# ubuntu/devel head, the 4.0.8+18.10.20180623-0ubuntu15 changelog entry
source=("git+https://gitlab.com/ubuntu-unity/unity/nux.git#commit=2c1878a8dae9c63ccc1efb9fad0943d14fe782a6"
        'fbo-attachment-arrays-resize.patch')
sha256sums=('SKIP'
            '077beb8a09c5b399dc5227546b5025da495e5fc024cc30e0861f3bab65ae7397')

prepare() {
  cd "${pkgname}"
  # the quilt series ships in the tree, it carries the pcre2 and icu ports plus
  # the -Werror and c++0x drops we'd otherwise have to do by hand
  while read -r p; do
    patch -Np1 -i "debian/patches/${p}"
  done < debian/patches/series
  # out of bounds vector index that _GLIBCXX_ASSERTIONS turns into an abort at startup
  patch -Np1 -i ../fbo-attachment-arrays-resize.patch
  NOCONFIGURE=1 ./autogen.sh
}

build() {
  cd "${pkgname}"
  # libexecdir so unity_support_test lands at /usr/lib/nux, that path is baked
  # into unity and into the xsession fallback checks
  ./configure --prefix=/usr --libexecdir=/usr/lib --disable-static \
    --disable-tests --disable-gputests --disable-examples \
    --disable-documentation --enable-gestures
  make
}

package() {
  cd "${pkgname}"
  make DESTDIR="${pkgdir}" install
  # debian's 50_check_unity_support is an Xsession.d snippet keyed on
  # DESKTOP_SESSION=ubuntu, nothing on arch sources that so it's dropped
}
